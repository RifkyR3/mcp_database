# Optional: Custom path to connections.json
# MCP_DB_CONFIG_PATH=./connections.json

# Optional: Global Database Filtering (comma-separated)
# ALLOWED_DATABASES=app_db,store_db

# Optional: Global Write Protection Rules
# WRITE_ALLOW=false
# WRITE_EXCEPTIONS=INSERT,UPDATE

# Optional: Fallback Environment Variables for Direct Connection
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=secret
# POSTGRES_DEFAULT_DB=postgres
# POSTGRES_DATABASES=db1,db2

# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=secret
# MYSQL_DEFAULT_DB=information_schema
# MYSQL_DATABASES=db1,db2
