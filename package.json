{
  "name": "mcp-database-server",
  "version": "1.0.0",
  "description": "Multi-database MCP Server with Dynamic Connections and Main/Sub connection architecture",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-database": "./dist/index.js"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "README.id.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "sync": "tsx src/sync.ts",
    "test": "tsx test/test-connection.ts",
    "test:write": "tsx test/test-write-rules.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "database",
    "mysql",
    "postgres",
    "sql"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "dotenv": "^18.0.5",
    "mysql2": "^3.24.5",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
